<Window x:Class="Veloce.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="VELOCE"
        Icon="pack://application:,,,/Assets/icon.png"
        Height="820" Width="1280"
        MinHeight="640" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        Foreground="#F0F0F0"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <!-- 0: Top Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Missing Engine Alert Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Main Workspace (Sidebar + Player & Timeline) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0. Top Bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" Click="OnOpenVideoClicked" Padding="14,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Folder20" Margin="0,0,8,0"/>
                        <TextBlock Text="Abrir Vídeo..." FontWeight="SemiBold"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/icon.png" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="VELOCE" FontSize="16" FontWeight="Black" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Width="1" Height="14" Background="#333333" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding VideoTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Text="Atalhos: Espaço (Play), Setas (Frame a Frame), I / O ([A] e [B]), Delete (Recortar), Ctrl+Z (Desfazer), Ctrl+Enter (Renderizar)"
                           FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 1. Motor de Motion Blur Alert Banner (1-Click Bootstrapper) -->
        <Border Grid.Row="1"
                Background="#1E1E1E"
                BorderBrush="#F59E0B"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,10"
                Visibility="{Binding IsEngineMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Warning Icon -->
                <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Message & Status -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Motor de Motion Blur não encontrado" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                    <TextBlock Text="O Tekno Blur é necessário para renderizar os clipes. Deseja baixar e configurar automaticamente?"
                               FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"
                               Visibility="{Binding IsBootstrapping, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                    <!-- Real-time Download & Install Progress -->
                    <StackPanel Visibility="{Binding IsBootstrapping, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0">
                        <TextBlock Text="{Binding BootstrapStatus}" FontSize="12" Foreground="#F59E0B" FontWeight="SemiBold"/>
                        <ProgressBar Value="{Binding BootstrapProgress}" Maximum="100" Height="4" Margin="0,4,0,0" Foreground="#F59E0B" Background="#262626"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Button -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:Button Appearance="Primary"
                               Content="⚡ Instalar Motor Automaticamente"
                               Click="OnBootstrapEngineClicked"
                               Visibility="{Binding IsBootstrapping, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                               FontWeight="Bold" Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Workspace (Avidemux Inspired: Left Sidebar + Right Video/Timeline) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar: Controls & Settings -->
                <ColumnDefinition Width="280" MinWidth="260" MaxWidth="340"/>
                <!-- Right Area: Video Viewport & Timeline/Transport -->
                <ColumnDefinition Width="*" MinWidth="600"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Configurações, Presets e Execução -->
            <Border Grid.Column="0" Background="#181818" CornerRadius="8" BorderBrush="#262626" BorderThickness="1" Padding="14" Margin="0,0,12,0">
                <DockPanel LastChildFill="True">
                    <!-- Rodapé da Sidebar: Execução, Status e Botões de Ação -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Border Height="1" Background="#262626" Margin="0,0,0,12"/>

                        <!-- Status & Progress -->
                        <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding RenderStatus}" FontSize="12" Foreground="#D1D5DB" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                        <ProgressBar Value="{Binding RenderProgress}" Maximum="100" Height="4" Margin="0,0,0,12" Background="#262626" Foreground="#3B82F6"/>

                        <!-- Primary Action Button -->
                        <ui:Button x:Name="BtnStartRender"
                                   Appearance="Primary"
                                   Content="⚡ CORTAR &amp; APLICAR BLUR"
                                   Click="OnStartRenderClicked"
                                   Visibility="{Binding IsRendering, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                   IsEnabled="{Binding CanEditTimeline}"
                                   FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Stretch"
                                   Height="40" Margin="0,0,0,6"/>

                        <!-- Cancel Button -->
                        <ui:Button x:Name="BtnCancelRender"
                                   Appearance="Secondary"
                                   Content="✖ Cancelar Render"
                                   Click="OnCancelRenderClicked"
                                   Visibility="{Binding IsRendering, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="#FF6B6B" FontWeight="SemiBold"
                                   HorizontalAlignment="Stretch"
                                   Height="38" Margin="0,0,0,6"/>

                        <!-- Open Output Folder Button -->
                        <ui:Button Appearance="Secondary"
                                   Content="📁 Abrir Pasta de Saída"
                                   Click="OnOpenFolderClicked"
                                   Visibility="{Binding HasCompletedRender, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Stretch"
                                   Height="38"/>
                    </StackPanel>

                    <!-- Conteúdo com Scroll da Sidebar (Presets, Configurações, Áudio) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Vertical">
                            <!-- SECTION 1: MOTION BLUR -->
                            <Border Background="#1E1E1E" CornerRadius="6" BorderBrush="#2D2D2D" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                        <ui:SymbolIcon Symbol="Flash20" Foreground="#60A5FA" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                        <TextBlock Text="MOTION BLUR" FontWeight="Bold" FontSize="12" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <TextBlock Text="Preset Selecionado:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding BlurPresets}"
                                              SelectedItem="{Binding SelectedBlurPreset, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Height="34" Margin="0,0,0,8"
                                              MaxDropDownHeight="360"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.CanContentScroll="False"
                                              PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Foreground="#EEEEEE" VerticalAlignment="Center" Padding="4,2"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <ui:Button Appearance="Secondary" Click="OnEditPresetClicked" ToolTip="Ajustar Sliders ou Adicionar/Editar Presets"
                                               HorizontalAlignment="Stretch" Padding="8,7" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Settings20" Foreground="#AAAAAA" Margin="0,0,6,0"/>
                                            <TextBlock Text="Configurar Preset" FontWeight="SemiBold" FontSize="12"/>
                                        </StackPanel>
                                    </ui:Button>

                                    <!-- Badge informativo com resumo do preset ativo -->
                                    <Border Background="#141414" CornerRadius="4" Padding="8,6" BorderBrush="#282828" BorderThickness="1">
                                        <TextBlock Text="{Binding SelectedPresetSummary}"
                                                   FontSize="11" FontFamily="Consolas, Cascadia Mono, monospace"
                                                   Foreground="#60A5FA" TextWrapping="Wrap" LineHeight="16"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: EXPORTAÇÃO & COMPRESSÃO -->
                            <Border Background="#1E1E1E" CornerRadius="6" BorderBrush="#2D2D2D" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                        <ui:SymbolIcon Symbol="ArrowExportUp20" Foreground="#60A5FA" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                        <TextBlock Text="EXPORTAÇÃO" FontWeight="Bold" FontSize="12" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <TextBlock Text="Compressão HandBrake:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding CompressionPresets}"
                                              SelectedItem="{Binding SelectedCompressionPreset, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Height="34" Margin="0,0,0,12"
                                              MaxDropDownHeight="360"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.CanContentScroll="False"
                                              PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Foreground="#EEEEEE" VerticalAlignment="Center" Padding="4,2"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <CheckBox Content="Mixar faixas de áudio"
                                              ToolTip="Mixar faixa de jogo com faixa de microfone em uma só"
                                              IsChecked="{Binding MixAudioTracks, Mode=TwoWay}"
                                              FontWeight="Medium"
                                              FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- RIGHT / MAIN: VIDEO VIEWPORT + TIMELINE + TRANSPORT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- 0: Video Player Surface -->
                    <RowDefinition Height="*"/>
                    <!-- 1: Timeline Moderna 36px -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2: Transporte Centralizado + Timecodes -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0. Video Player Surface -->
                <Border Grid.Row="0" Background="#000000" CornerRadius="8" BorderBrush="#222222" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <!-- Windows Forms Host for MPV HWND -->
                        <WindowsFormsHost x:Name="HwndHostContainer" Visibility="Collapsed">
                            <wf:Panel x:Name="MpvHostPanel" BackColor="Black" />
                        </WindowsFormsHost>

                        <!-- WPF Fallback MediaElement -->
                        <MediaElement x:Name="FallbackMediaElement" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" ScrubbingEnabled="True"/>
                        <Image x:Name="DemoPreviewImage" Stretch="Uniform" Visibility="Collapsed"/>

                        <!-- Placeholder overlay when no video loaded -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasVideoLoaded, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="🎬" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.8"/>
                            <TextBlock Text="Arraste seu vídeo de gameplay aqui para cortar" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#CCCCCC"/>
                            <TextBlock Text="Suporta clipes ShadowPlay, OBS, Medal (60, 120 e 240 FPS)" FontSize="12" HorizontalAlignment="Center" Foreground="#666666" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. Timeline Moderna 36px (Logo abaixo do vídeo estilo Avidemux) -->
                <Border Grid.Row="1"
                        x:Name="TimelineTrackBorder"
                        Height="36" Background="#161616"
                        CornerRadius="8" BorderBrush="#2D2D2D" BorderThickness="1"
                        ClipToBounds="True" Cursor="Hand"
                        MouseDown="OnTimelineTrackMouseDown"
                        MouseMove="OnTimelineTrackMouseMove"
                        MouseUp="OnTimelineTrackMouseUp"
                        SizeChanged="OnTimelineTrackSizeChanged"
                        Margin="0,8,0,6">
                    <Canvas x:Name="TimelineCanvas" Background="Transparent" Height="36">
                        <Canvas.Resources>
                            <!-- Subtle Avidemux-inspired ruler tick marks -->
                            <DrawingBrush x:Key="RulerTickBrush" TileMode="Tile" Viewport="0,0,10,6" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#262626" Thickness="1"/>
                                        </GeometryDrawing.Pen>
                                        <GeometryDrawing.Geometry>
                                            <LineGeometry StartPoint="0,0" EndPoint="0,5"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Canvas.Resources>

                        <!-- Ruler tick marks at the top edge -->
                        <Rectangle Canvas.Left="0" Canvas.Top="0"
                                   Width="{Binding ElementName=TimelineCanvas, Path=ActualWidth}"
                                   Height="5" Fill="{StaticResource RulerTickBrush}" IsHitTestVisible="False"/>

                        <!-- Central track rail -->
                        <Rectangle Canvas.Left="0" Canvas.Top="16"
                                   Width="{Binding ElementName=TimelineCanvas, Path=ActualWidth}"
                                   Height="4" Fill="#222222" RadiusX="2" RadiusY="2" IsHitTestVisible="False"/>

                        <!-- Played progress bar (blue track) -->
                        <Rectangle x:Name="TrackProgressRect" Canvas.Left="0" Canvas.Top="16"
                                   Height="4" Fill="#3B82F6" RadiusX="2" RadiusY="2" IsHitTestVisible="False"/>

                        <!-- Selection Range [A, B] (Translucent band with 3px side handles) -->
                        <Border x:Name="SelectionHighlightBorder"
                                Canvas.Top="0" Height="36"
                                Background="#333B82F6"
                                BorderBrush="#60A5FA"
                                BorderThickness="3,0,3,0"
                                CornerRadius="2"
                                IsHitTestVisible="False"/>

                        <!-- Playhead Line (2px white traversing full 36px) -->
                        <Line x:Name="PlayheadLine" X1="0" Y1="0" X2="0" Y2="36" Stroke="#FFFFFF" StrokeThickness="2" IsHitTestVisible="False"/>

                        <!-- Playhead Top Marker / Thumb (Traversing top of timeline) -->
                        <Polygon x:Name="PlayheadThumb" Points="-6,0 6,0 6,8 0,14 -6,8" Fill="#FFFFFF" Canvas.Top="0" IsHitTestVisible="False"/>
                    </Canvas>
                </Border>

                <!-- 2. Transporte Centralizado + Timecodes nas Pontas -->
                <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="8" BorderBrush="#2D2D2D" BorderThickness="1" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Left: Timecode & Duration -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Center: Grouped Transport Buttons -->
                            <ColumnDefinition Width="*"/>
                            <!-- Right: Discrete [A] and [B] Badges -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Current / Total Timecode & Selection Duration -->
                        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CurrentTimeText}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding SelectionDurationText}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11" Foreground="#888888" Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- Center: Grouped Transport Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Navigation -->
                            <ui:Button Appearance="Secondary" ToolTip="Início do vídeo (Home)" Click="OnJumpToStartClicked" Padding="6,5" Margin="0,0,2,0">
                                <ui:SymbolIcon Symbol="Previous20"/>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" ToolTip="-60s (PageDown)" Click="OnStepBack60SecClicked" Padding="5,5" Margin="0,0,2,0">
                                <TextBlock Text="-60s" FontSize="11" FontWeight="SemiBold"/>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" ToolTip="Keyframe Anterior (Seta Baixo)" Click="OnPrevKeyframeClicked" Padding="6,5" Margin="0,0,2,0">
                                <ui:SymbolIcon Symbol="ChevronDoubleLeft20"/>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" ToolTip="Voltar 1 frame exato (Seta Esquerda)" Click="OnStepBackClicked" Padding="6,5" Margin="0,0,2,0">
                                <ui:SymbolIcon Symbol="ChevronLeft20"/>
                            </ui:Button>

                            <!-- Play / Pause -->
                            <ui:Button x:Name="BtnPlayPause" Appearance="Secondary" ToolTip="Play / Pausar (Espaço)" Click="OnPlayPauseClicked" Padding="10,5" Margin="2,0,2,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="PlayPauseIcon" Symbol="Play20" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="PlayPauseText" Text="Play" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </ui:Button>

                            <!-- Forward navigation -->
                            <ui:Button Appearance="Secondary" ToolTip="Avançar 1 frame exato (Seta Direita)" Click="OnStepForwardClicked" Padding="6,5" Margin="0,0,2,0">
                                <ui:SymbolIcon Symbol="ChevronRight20"/>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" ToolTip="Próximo Keyframe (Seta Cima)" Click="OnNextKeyframeClicked" Padding="6,5" Margin="0,0,2,0">
                                <ui:SymbolIcon Symbol="ChevronDoubleRight20"/>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" ToolTip="+60s (PageUp)" Click="OnStepForward60SecClicked" Padding="5,5" Margin="0,0,2,0">
                                <TextBlock Text="+60s" FontSize="11" FontWeight="SemiBold"/>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" ToolTip="Fim do vídeo (End)" Click="OnJumpToEndClicked" Padding="6,5" Margin="0,0,2,0">
                                <ui:SymbolIcon Symbol="Next20"/>
                            </ui:Button>

                            <Separator Width="1" Height="18" Background="#2D2D2D" Margin="4,0,4,0"/>

                            <!-- Markers [A] and [B] -->
                            <ui:Button Appearance="Secondary" Click="OnSetMarkerAClicked" ToolTip="Definir Início [A] (Atalho: A, I ou [)" Padding="9,5" Margin="0,0,2,0">
                                <TextBlock Text="[ A" FontWeight="Bold" Foreground="#60A5FA" FontSize="12"/>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" Click="OnClearSelectionClicked" ToolTip="Limpar Seleção (Atalho: X)" Padding="7,5" Margin="0,0,2,0">
                                <ui:SymbolIcon Symbol="Dismiss16" Foreground="#888888"/>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" Click="OnSetMarkerBClicked" ToolTip="Definir Fim [B] (Atalho: B, O ou ])" Padding="9,5" Margin="0,0,2,0">
                                <TextBlock Text="B ]" FontWeight="Bold" Foreground="#60A5FA" FontSize="12"/>
                            </ui:Button>

                            <Separator Width="1" Height="18" Background="#2D2D2D" Margin="4,0,4,0"/>

                            <!-- Cut and Undo -->
                            <ui:Button Appearance="Secondary" Click="OnDeleteSelectionClicked" ToolTip="Remove o trecho selecionado da timeline (Tecla Delete)" Padding="10,5" Margin="0,0,3,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Cut20" Foreground="#FF6B6B" Margin="0,0,5,0"/>
                                    <TextBlock Text="Recortar" FontWeight="SemiBold" Foreground="#FF6B6B" FontSize="12"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" Click="OnUndoClicked" ToolTip="Desfaz o último corte (Ctrl+Z)" Padding="8,5">
                                <ui:SymbolIcon Symbol="ArrowUndo20" Foreground="#AAAAAA"/>
                            </ui:Button>
                        </StackPanel>

                        <!-- Right: Discrete Clickable [A] and [B] Badges -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Border Background="#16222F" BorderBrush="#253545" BorderThickness="1" CornerRadius="4" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="Clique para pular para o Marcador [A]" MouseLeftButtonDown="OnJumpToMarkerAClicked">
                                <TextBlock Text="{Binding MarkerAText}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA"/>
                            </Border>
                            <Border Background="#2B1717" BorderBrush="#452323" BorderThickness="1" CornerRadius="4" Padding="7,4" Cursor="Hand" ToolTip="Clique para pular para o Marcador [B]" MouseLeftButtonDown="OnJumpToMarkerBClicked">
                                <TextBlock Text="{Binding MarkerBText}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11" FontWeight="SemiBold" Foreground="#F87171"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
