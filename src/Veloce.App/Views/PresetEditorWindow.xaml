<Window x:Class="Veloce.App.Views.PresetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Editar Preset do Motion Blur"
        Height="730" Width="560"
        MinHeight="600" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        Background="#121212"
        Foreground="#EEEEEE">

    <Window.Resources>
        <!-- Modern Fluent Slider with high-contrast active track & sharp thumb -->
        <Style x:Key="FluentSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Background Track Rail -->
                            <Border x:Name="TrackBackground" Height="6" Background="#262626" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center"/>

                            <!-- Interactive Track with filled blue progress and white circular thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="#3B82F6" CornerRadius="3,0,0,3" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="18" Height="18">
                                                    <Ellipse x:Name="ThumbBorder" Fill="#FFFFFF" Stroke="#3B82F6" StrokeThickness="2.5"/>
                                                    <Ellipse Width="6" Height="6" Fill="#1E1E1E"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Fill" Value="#E0F2FE"/>
                                                        <Setter TargetName="ThumbBorder" Property="Stroke" Value="#60A5FA"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Fill" Value="#93C5FD"/>
                                                        <Setter TargetName="ThumbBorder" Property="Stroke" Value="#1D4ED8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Form Body ScrollViewer -->
            <RowDefinition Height="*"/>
            <!-- 2: Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Settings24" Foreground="#3B82F6" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Configurações do Preset de Motion Blur" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Ajuste o modo matemático de blur, intensidade e interpolação" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- 1. Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <!-- Card 1: Identificação -->
                <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Nome do Preset:" FontWeight="SemiBold" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtName" Height="34" FontSize="13" Padding="8,6" Background="#121212" Foreground="#FFFFFF" BorderBrush="#333333"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Modo de Blur & Intensidade -->
                <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="MODO DE BLUR &amp; INTENSIDADE" FontWeight="Bold" FontSize="11" Foreground="#60A5FA" Margin="0,0,0,10"/>

                        <!-- Modo de Ponderação (Weighting) -->
                        <TextBlock Text="Modo de Ponderação (Weighting):" FontWeight="SemiBold" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbWeighting" SelectedValuePath="Tag" Height="34" Margin="0,0,0,14" MaxDropDownHeight="240">
                            <ComboBoxItem Tag="gaussian" Content="Gaussiano (Mais suave e natural - Recomendado)" IsSelected="True"/>
                            <ComboBoxItem Tag="gaussian_sym" Content="Gaussiano Simétrico (Pico central balanceado)"/>
                            <ComboBoxItem Tag="equal" Content="Uniforme / Linear (Média simples dos frames)"/>
                            <ComboBoxItem Tag="pyramid" Content="Pirâmide / Triangular (Pico gradual no centro)"/>
                            <ComboBoxItem Tag="vegas" Content="Estilo Sony Vegas (Clássico de game clips)"/>
                            <ComboBoxItem Tag="ascending" Content="Crescente (Rastro mais denso para trás)"/>
                            <ComboBoxItem Tag="descending" Content="Decrescente (Rastro mais denso para frente)"/>
                        </ComboBox>

                        <!-- Blur Amount Slider -->
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <Border DockPanel.Dock="Right" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ElementName=SliderBlurAmount, Path=Value, StringFormat={}{0:F2}}" FontFamily="Consolas, Cascadia Mono" FontWeight="Bold" Foreground="#60A5FA" Width="36" TextAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Intensidade do Blur (Blur Amount):" FontWeight="SemiBold" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="SliderBlurAmount" Style="{StaticResource FluentSlider}" Minimum="0.10" Maximum="3.00" SmallChange="0.05" LargeChange="0.25" Margin="0,4,0,2"/>
                        <Grid Margin="2,0,2,14">
                            <TextBlock Text="0.10 (Mínimo)" FontSize="10" Foreground="#666666" HorizontalAlignment="Left"/>
                            <TextBlock Text="1.35 (Padrão)" FontSize="10" Foreground="#555555" HorizontalAlignment="Center"/>
                            <TextBlock Text="3.00 (Extremo)" FontSize="10" Foreground="#666666" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Blur Gamma Slider -->
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <Border DockPanel.Dock="Right" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ElementName=SliderBlurGamma, Path=Value, StringFormat={}{0:F2}}" FontFamily="Consolas, Cascadia Mono" FontWeight="Bold" Foreground="#60A5FA" Width="36" TextAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Correção Gamma do Blur:" FontWeight="SemiBold" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="SliderBlurGamma" Style="{StaticResource FluentSlider}" Minimum="1.00" Maximum="2.20" SmallChange="0.05" LargeChange="0.20" Value="1.40" Margin="0,4,0,2"/>
                        <Grid Margin="2,0,2,4">
                            <TextBlock Text="1.00 (Linear)" FontSize="10" Foreground="#666666" HorizontalAlignment="Left"/>
                            <TextBlock Text="1.40 (Recomendado)" FontSize="10" Foreground="#555555" HorizontalAlignment="Center"/>
                            <TextBlock Text="2.20 (sRGB)" FontSize="10" Foreground="#666666" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Taxa de Quadros & Interpolação -->
                <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="TAXA DE QUADROS &amp; INTERPOLAÇÃO" FontWeight="Bold" FontSize="11" Foreground="#60A5FA" Margin="0,0,0,10"/>

                        <!-- Output FPS Slider -->
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <Border DockPanel.Dock="Right" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ElementName=SliderOutputFps, Path=Value, StringFormat={}{0:F0} fps}" FontFamily="Consolas, Cascadia Mono" FontWeight="Bold" Foreground="#60A5FA" Width="52" TextAlignment="Center"/>
                            </Border>
                            <TextBlock Text="FPS Final de Saída:" FontWeight="SemiBold" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="SliderOutputFps" Style="{StaticResource FluentSlider}" Minimum="30" Maximum="240" SmallChange="10" LargeChange="30" TickFrequency="30" IsSnapToTickEnabled="False" Margin="0,4,0,2"/>
                        <Grid Margin="2,0,2,14">
                            <TextBlock Text="30 fps" FontSize="10" Foreground="#666666" HorizontalAlignment="Left"/>
                            <TextBlock Text="60 fps (Padrão)" FontSize="10" Foreground="#555555" Margin="50,0,0,0"/>
                            <TextBlock Text="120 fps" FontSize="10" Foreground="#555555" HorizontalAlignment="Center"/>
                            <TextBlock Text="240 fps" FontSize="10" Foreground="#666666" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Método de Interpolação -->
                        <TextBlock Text="Método de Interpolação de Movimento:" FontWeight="SemiBold" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbInterpolationMethod" SelectedValuePath="Tag" Height="34" Margin="0,0,0,14" MaxDropDownHeight="160">
                            <ComboBoxItem Tag="svp" Content="SVP (Interpolação ultrarrápida por vetores de movimento)" IsSelected="True"/>
                            <ComboBoxItem Tag="rife" Content="RIFE (Rede Neural AI - Máxima precisão geométrica)"/>
                        </ComboBox>

                        <!-- Interpolated FPS -->
                        <TextBlock Text="FPS Intermediário de Mistura (Interpolated FPS):" FontWeight="SemiBold" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtInterpolatedFps" Height="34" FontSize="13" Padding="8,6" Background="#121212" Foreground="#FFFFFF" BorderBrush="#333333" Margin="0,0,0,4"/>
                        <TextBlock Text="Valores comuns: 720 (rápido), 1440 (alta qualidade), 2880 (ultra fluidez)" FontSize="10" Foreground="#666666"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Qualidade NVENC -->
                <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="QUALIDADE DE CODIFICAÇÃO (NVENC CQ)" FontWeight="Bold" FontSize="11" Foreground="#60A5FA" Margin="0,0,0,10"/>

                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <Border DockPanel.Dock="Right" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ElementName=SliderQuality, Path=Value, StringFormat={}CQ {0:F0}}" FontFamily="Consolas, Cascadia Mono" FontWeight="Bold" Foreground="#60A5FA" Width="48" TextAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Fator de Qualidade (menor número = maior nitidez):" FontWeight="SemiBold" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="SliderQuality" Style="{StaticResource FluentSlider}" Minimum="10" Maximum="30" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,2"/>
                        <Grid Margin="2,0,2,4">
                            <TextBlock Text="10 (Sem perdas visual)" FontSize="10" Foreground="#666666" HorizontalAlignment="Left"/>
                            <TextBlock Text="14 (Padrão ideal)" FontSize="10" Foreground="#555555" HorizontalAlignment="Center"/>
                            <TextBlock Text="30 (Arquivo menor)" FontSize="10" Foreground="#666666" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 2. Footer Buttons -->
        <Border Grid.Row="2" Padding="0,14,0,0" BorderBrush="#222222" BorderThickness="0,1,0,0" Margin="0,8,0,0">
            <Grid>
                <ui:Button Appearance="Secondary" Content="📄 JSON" ToolTip="Abrir arquivo presets.json no Bloco de Notas" Click="OnOpenJsonClicked" HorizontalAlignment="Left" Padding="10,7"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BtnDelete" Appearance="Secondary" Content="🗑 Excluir" Click="OnDeleteClicked" Foreground="#FF6B6B" Margin="0,0,8,0" Padding="10,7"/>
                    <ui:Button Appearance="Secondary" Content="➕ Salvar como Novo" Click="OnSaveAsNewClicked" Margin="0,0,8,0" Padding="12,7"/>
                    <ui:Button Appearance="Primary" Content="Salvar Alterações" Click="OnSaveClicked" IsDefault="True" FontWeight="Bold" Padding="18,7"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
